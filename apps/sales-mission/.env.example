# Shared Supabase project used by LeadEngine and Sales Activity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App-switcher destination. Production example: https://crm.werkudara.com
NEXT_PUBLIC_LEADENGINE_URL=http://localhost:3000

# Parent domain for the shared auth cookie, so one login covers both apps.
# Production: .werkudara.com — must match LeadEngine exactly, leading dot included.
# Leave empty locally: cookies ignore ports, so :3000 and :3001 already share a session.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Server-only. Never expose in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# LeadEngine /api/v1 base URL, used server-side to push leads and search
# companies. Local: http://localhost:3000 — production: https://crm.werkudara.com
# No API key: the signed-in user's Supabase token is forwarded, so LeadEngine
# applies that person's own permissions and RLS.
LEADENGINE_API_URL=
