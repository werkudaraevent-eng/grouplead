# ─── LeadEngine environment template ─────────────────────────────────────────
# Copy to `.env.local` and fill in the values. `.env.local` is git-ignored.
# Never commit real keys.

# ── Supabase (required) ──
# Project URL + anon key drive the browser + server clients (RLS-enforced).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App-switcher destination. Production example: https://mission.werkudara.com
NEXT_PUBLIC_SALES_MISSION_URL=http://localhost:3001

# Parent domain for the shared auth cookie, so one login covers both apps.
# Production: .werkudara.com — must match Sales Activity exactly, leading dot included.
# Leave empty locally: cookies ignore ports, so :3000 and :3001 already share a session.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# ── Supabase service role (server-only, required for admin ops + scripts) ──
# Bypasses RLS. Used by server actions (createServiceClient) and scripts/.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── City autocomplete (optional) ──
# Provide ONE of the following to enable Event City suggestions.
# GeoNames: free, register at https://www.geonames.org/login
GEONAMES_USERNAME=
# Google Places: alternative provider.
GOOGLE_PLACES_API_KEY=

# ── AI (optional fallback) ──
# The AI connection is set in the app under Settings → AI and stored in the
# shared public.ai_settings row (key in Supabase Vault). These variables are
# used only while that row is empty, e.g. on a fresh local setup.
AI_PROXY_URL=
AI_PROXY_KEY=
AI_MODEL_FAST=
AI_MODEL_REASONING=
