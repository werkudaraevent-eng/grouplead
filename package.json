{
  "name": "werkudara-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@werkudara/leadengine",
    "dev:leadengine": "npm run dev --workspace=@werkudara/leadengine",
    "dev:sales-mission": "npm run dev --workspace=@werkudara/sales-mission",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=@werkudara/leadengine",
    "lint": "npm run lint --workspace=@werkudara/leadengine",
    "typecheck": "npm run typecheck --workspace=@werkudara/leadengine",
    "test": "npm run test --workspace=@werkudara/leadengine",
    "test:e2e": "npm run test:e2e --workspace=@werkudara/leadengine",
    "test:e2e:ui": "npm run test:e2e:ui --workspace=@werkudara/leadengine",
    "db:dump-schema": "npm run db:dump-schema --workspace=@werkudara/leadengine"
  },
  "engines": {
    "node": ">=20"
  }
}
